#ifdef __MINGW32__
#include <winuser.h>
1 RT_MANIFEST "ygopro.exe.manifest"
#endif

1 ICON "ygopro.ico"

1 VERSIONINFO
FILEVERSION 41, 0, 2, 0
PRODUCTVERSION 41, 0, 2, 0
FILEOS 0x4
FILETYPE 0x1

BEGIN
	BLOCK "StringFileInfo"
	BEGIN
		BLOCK "000904b0"
		BEGIN
			VALUE "OriginalFilename", "YEdo Mod Pro.exe"
			VALUE "InternalName", "ygoprodll"
			VALUE "FileVersion", "41.0.2.0"
			VALUE "ProductName", "YEdo Mod Pro"
			VALUE "ProductVersion", "41.0.2.0"
			VALUE "LegalCopyright", "Copyright (C) 2020-2026 edo9300 and others"
			VALUE "CompanyName", "Project Ignis"
			VALUE "FileDescription", "YEdo Mod Pro - story mod based on Project Ignis: EDOPro"
		END
	END
	BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x9, 1200
	END
END
